    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\n\nconst photoUrls = Array.isArray(body.photo_urls)\n  ? body.photo_urls.filter((u) => typeof u === 'string' && /^https?:\\/\\//i.test(u)).slice(0, 10)\n  : [];\n\nlet text = typeof body.body_text === 'string' && body.body_text.trim()\n  ? body.body_text.trim()\n  : typeof body.body === 'string'\n    ? body.body\n    : '';\n\n// Fallback si ancienne app sans body_text/photo_urls : extraire les URLs image du body.\nif (!photoUrls.length && text) {\n  const lines = text.split('\\n');\n  const keep = [];\n  for (const line of lines) {\n    const t = line.trim();\n    if (/^https?:\\/\\//i.test(t) && (/\\.(jpe?g|png|gif|webp)(\\?|#|$)/i.test(t) || /\\/storage\\/v1\\/object\\//i.test(t))) {\n      photoUrls.push(t);\n    } else {\n      keep.push(line);\n    }\n  }\n  text = keep.join('\\n').trim();\n}\n\nconst embeds = photoUrls.map((url) => ({ image: { url } }));\nconst content =\n  (text || (photoUrls.length ? `📷 ${photoUrls.length} photo(s)` : '(message vide)')).slice(0, 1900);\n\nconst threadName = (typeof body.thread_name === 'string' && body.thread_name.trim()\n  ? body.thread_name.trim()\n  : `Général - ${(body.client_name || 'Visiteur')}`).slice(0, 100);\n\nreturn [{\n  json: {\n    ...raw,\n    body: {\n      ...body,\n      thread_name: threadName,\n      discord_content: content,\n      discord_embeds: embeds,\n      photo_urls: photoUrls,\n    },\n  },\n}];"
      },
